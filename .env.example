# Copy this file to .env.local and fill in the values.

# Supabase → Project Settings → API (or "API Keys")
SUPABASE_URL=https://your-project-ref.supabase.co
# The secret key (sb_secret_...) or the legacy service_role key. Server-only — never expose it.
SUPABASE_SECRET_KEY=
# Storage bucket for uploads (created by supabase/schema.sql)
SUPABASE_BUCKET=portfolio

# Password for /admin
ADMIN_PASSWORD=
# Optional: a long random string used to sign login sessions (defaults to ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=
